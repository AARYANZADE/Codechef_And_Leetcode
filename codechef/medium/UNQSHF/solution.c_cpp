#include <bits/stdc++.h>
using namespace std;

int main() {int n;
    cin >> n;
    string a, b;
    cin >> a >> b;

    int aofa = 0;
    int bofa = 0;

    for (int i = 0; i < n; i++) {
        if (a[i] == 'a') {
            aofa++;
        }
        if (b[i] == 'b') {
            bofb++;
        }
    }

    if (aofa == bofb) {
        cout << "YES"<<endl;
    } else {
        cout << "NO"<<endl;
    }
}
}
