#include <iostream>
using namespace std;

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    cin >> t;

    while (t--) {
        int x, y;
        cin >> x >> y;

        if (x < y) {
            cout << "REPAIR\n";
        } else if (x > y) {
            cout << "NEW PHONE\n";
        } else {
            cout << "ANY\n";
        }
    }

    return 0;
}