#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int x, y, z;
        cin >> x >> y >> z;

        if (x > max(y, z)) {
            cout << "Setter\n";
        } else if (y > max(x, z)) {
            cout << "Tester\n";
        } else {
            cout << "Editorialist\n";
        }
    }

    return 0;
}