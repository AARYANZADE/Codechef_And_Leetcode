#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t ;
cin >> t ;
while (t--){
    int a , b , c , d, e , f  ;
    cin >> a >> b >> c >> d ;
    e = b - a ;
    f = c * d ;
    if (e > f ){
        cout << "unfilled"<<endl;
    }
    else if (e<f) {
        cout <<"overflow"<<endl;
    }
    if (e == f){
        cout << "filled"<<endl;
    }
}
}
