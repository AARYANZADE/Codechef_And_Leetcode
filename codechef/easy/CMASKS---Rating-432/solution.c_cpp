#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int x, y;
        cin >> x >> y;

        int disposable_cost = 100 * x;
        int cloth_cost = 10 * y;

        if (cloth_cost <= disposable_cost) {
            cout << "Cloth\n";
        } else {
            cout << "Disposable\n";
        }
    }

    return 0;
}